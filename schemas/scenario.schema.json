{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/scenario.schema.json",
  "title": "Acceptance Scenario",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "contract_refs",
    "given",
    "when",
    "then"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "scenario" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "$ref": "#/$defs/status" },
    "summary": { "type": "string", "minLength": 1 },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "given": {
      "type": "object",
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "operator", "value"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "operator": { "$ref": "#/$defs/operator" },
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "prior_command": {
          "type": "object",
          "required": ["command_ref", "command_id", "outcome_code"],
          "properties": {
            "command_ref": { "$ref": "#/$defs/id" },
            "command_id": { "type": "string", "minLength": 1 },
            "outcome_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "when": {
      "type": "object",
      "required": ["command_ref", "input"],
      "properties": {
        "command_ref": { "$ref": "#/$defs/id" },
        "input": { "type": "object" },
        "repeat": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "then": {
      "type": "object",
      "required": ["outcome", "state", "events", "forbidden"],
      "properties": {
        "outcome": {
          "type": "object",
          "required": ["status", "code"],
          "properties": {
            "status": { "enum": ["success", "failure"] },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
            },
            "same_as_first": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "required": ["assertions"],
          "properties": {
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/assertion" }
            }
          },
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "required": ["assertions"],
          "properties": {
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["event_ref", "count"],
                "properties": {
                  "event_ref": { "$ref": "#/$defs/id" },
                  "count": { "type": "integer", "minimum": 0 },
                  "payload": { "type": "object" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["state_change", "event", "side_effect"] },
              "path": { "type": "string", "minLength": 1 },
              "event_ref": { "$ref": "#/$defs/id" },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    },
    "operator": {
      "enum": ["equals", "not_equals", "greater_than", "contains", "count_equals", "exists"]
    },
    "assertion": {
      "type": "object",
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/$defs/operator" },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
