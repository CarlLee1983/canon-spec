{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/implementation-manifest.schema.json",
  "title": "Implementation Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "task_id",
    "objective",
    "implementation_target",
    "contract_revisions",
    "required_deliverables",
    "architecture_constraints",
    "completion_conditions",
    "ambiguity_policy",
    "traceability_output",
    "forbidden_behavior"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "implementation-manifest" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "objective": { "type": "string", "minLength": 1 },
    "implementation_target": {
      "type": "object",
      "required": ["language", "architecture_profile"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "architecture_profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contract_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract_ref", "version"],
        "properties": {
          "contract_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        },
        "additionalProperties": false
      }
    },
    "required_deliverables": { "$ref": "#/$defs/nonEmptyStrings" },
    "architecture_constraints": { "$ref": "#/$defs/nonEmptyStrings" },
    "completion_conditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "ambiguity_policy": {
      "type": "object",
      "required": ["on_undefined", "on_conflict", "clarification_location"],
      "properties": {
        "on_undefined": { "const": "stop_and_request_clarification" },
        "on_conflict": { "const": "stop_and_request_clarification" },
        "clarification_location": { "const": "clarifications/" }
      },
      "additionalProperties": false
    },
    "traceability_output": {
      "type": "object",
      "required": ["required", "format", "maps"],
      "properties": {
        "required": { "const": true },
        "format": { "type": "string", "minLength": 1 },
        "maps": { "$ref": "#/$defs/nonEmptyStrings" }
      },
      "additionalProperties": false
    },
    "forbidden_behavior": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
