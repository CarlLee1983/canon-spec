{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/state-machine.schema.json",
  "title": "State Machine Contract",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "aggregate_ref",
    "initial_state",
    "states",
    "transitions",
    "forbidden_transitions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "state-machine" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "$ref": "#/$defs/status" },
    "aggregate_ref": { "$ref": "#/$defs/id" },
    "initial_state": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "terminal"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "terminal": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "trigger_ref", "from", "to"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "trigger_ref": { "$ref": "#/$defs/id" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "event_ref": { "$ref": "#/$defs/id" }
        },
        "additionalProperties": false
      }
    },
    "forbidden_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_ref", "from", "to"],
        "properties": {
          "rule_ref": { "$ref": "#/$defs/id" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "clarification_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    }
  }
}
