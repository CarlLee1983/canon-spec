{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/decision.schema.json",
  "title": "Decision Record Front Matter",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "title",
    "problem",
    "background",
    "decision",
    "rejected_options",
    "consequences",
    "revisit_when"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "decision" },
    "id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    },
    "title": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "background": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "rejected_options": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "revisit_when": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
