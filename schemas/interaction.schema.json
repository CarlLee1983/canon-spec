{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/interaction.schema.json",
  "title": "Cross-context Interaction Contract",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "producer_context_ref",
    "consumer_context_ref",
    "purpose",
    "success",
    "failures",
    "idempotency",
    "duplicate_handling",
    "unspecified_behavior"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "interaction" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "$ref": "#/$defs/status" },
    "producer_context_ref": { "$ref": "#/$defs/id" },
    "consumer_context_ref": { "$ref": "#/$defs/id" },
    "purpose": { "type": "string", "minLength": 1 },
    "trigger_ref": { "$ref": "#/$defs/id" },
    "success": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "outcome"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
          },
          "outcome": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "idempotency": {
      "type": "object",
      "required": ["key", "duplicate_side_effects"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "duplicate_side_effects": { "const": "prohibited" }
      },
      "additionalProperties": false
    },
    "duplicate_handling": {
      "type": "object",
      "required": ["detection_key", "outcome"],
      "properties": {
        "detection_key": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "unspecified_behavior": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": { "const": "prohibited_to_assume" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    }
  }
}
