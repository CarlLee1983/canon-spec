{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canon-spec.local/schemas/command.schema.json",
  "title": "Command Contract",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "status",
    "summary",
    "actor",
    "input",
    "preconditions",
    "success",
    "effects",
    "idempotency",
    "unspecified_behavior"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "command" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "$ref": "#/$defs/status" },
    "summary": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          {
            "required": ["rule_ref"],
            "properties": { "rule_ref": { "$ref": "#/$defs/id" } },
            "additionalProperties": false
          },
          {
            "required": ["contract_ref"],
            "properties": { "contract_ref": { "$ref": "#/$defs/id" } },
            "additionalProperties": false
          }
        ]
      }
    },
    "success": {
      "type": "object",
      "required": ["code", "result"],
      "properties": {
        "code": { "$ref": "#/$defs/outcomeCode" },
        "result": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["state_changes", "events"],
      "properties": {
        "state_changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateChange" }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_ref", "count"],
            "properties": {
              "event_ref": { "$ref": "#/$defs/id" },
              "count": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "when", "state_change", "emitted_events"],
        "properties": {
          "code": { "$ref": "#/$defs/outcomeCode" },
          "when": {
            "type": "string",
            "pattern": "\\b(MUST|MUST NOT|SHALL|SHALL NOT)\\b"
          },
          "state_change": { "const": "none" },
          "emitted_events": { "const": "none" }
        },
        "additionalProperties": false
      }
    },
    "no_failures": {
      "type": "object",
      "required": ["declared", "rationale"],
      "properties": {
        "declared": { "const": true },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "required": ["key", "duplicate_behavior", "duplicate_side_effects"],
      "properties": {
        "key": { "const": "command_id" },
        "duplicate_behavior": { "const": "return_original_outcome" },
        "duplicate_side_effects": { "const": "prohibited" }
      },
      "additionalProperties": false
    },
    "unspecified_behavior": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": { "const": "prohibited_to_assume" }
      },
      "additionalProperties": false
    },
    "clarification_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    }
  },
  "oneOf": [
    { "required": ["failures"], "not": { "required": ["no_failures"] } },
    { "required": ["no_failures"], "not": { "required": ["failures"] } }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "candidate", "accepted", "deprecated", "retired"]
    },
    "outcomeCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "field": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "stateChange": {
      "type": "object",
      "required": ["aggregate_ref", "transition_ref", "changes"],
      "properties": {
        "aggregate_ref": { "$ref": "#/$defs/id" },
        "transition_ref": { "$ref": "#/$defs/id" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
